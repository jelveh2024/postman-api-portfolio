    {
      "name": "Create user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomNum = Math.floor(Math.random() * 100000);",
              "",
              "pm.environment.set(",
              "    \"randomEmail\",",
              "    `user${randomNum}@jgtest.com`",
              ");",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "// const id = Number(jsonData.id);",
              "const expectedEmail = pm.environment.get(\"randomEmail\");",
              "pm.environment.set(\"userId\", jsonData.id);",
              "",
              "pm.test(\"User ID saved\", function () {",
              "    pm.expect(jsonData.id).to.exist;",
              "});",
              "",
              "pm.test(\"Email address is correct\", function () {",
              "    pm.expect(jsonData.email).to.eql(expectedEmail);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jelveh Demo Tester\",\n  \"email\": \"{{randomEmail}}\"\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{CRUDbaseUrl}}/users",
          "host": [
            "{{CRUDbaseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Verify user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "const expectedEmail = pm.environment.get(\"randomEmail\");",
              "const schema = {",
              "    type: \"object\",",
              "    required: [\"id\", \"name\", \"email\", \"createdAt\"],",
              "    properties: {",
              "        id: { type: \"string\" },",
              "        name: { type: \"string\" },",
              "        email: { type: \"string\" },",
              "        createdAt: { type: \"string\" }",
              "    }",
              "};",
              "",
              "pm.test(\"Email address is correct\", function () {",
              "    pm.expect(jsonData.email).to.eql(expectedEmail);",
              "});",
              "",
              "pm.test(\"Schema is valid\", function () {",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
