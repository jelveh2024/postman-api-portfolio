  "item": [
    {
      "name": "United States Of America",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Array length, status code, array response, nested object values, response structure keys",
              "",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const countryData = pm.response.json();",
              "const expectedTimezones = [",
              "    \"UTC-12:00\",",
              "    \"UTC-11:00\",",
              "    \"UTC-10:00\",",
              "    \"UTC-09:00\",",
              "    \"UTC-08:00\",",
              "    \"UTC-07:00\",",
              "    \"UTC-06:00\",",
              "    \"UTC-05:00\",",
              "    \"UTC-04:00\",",
              "    \"UTC+10:00\",",
              "    \"UTC+12:00\"",
              "];",
              "",
              "const requiredKeys = [",
              "        \"tld\",",
              "        \"cca2\",",
              "        \"ccn3\",",
              "        \"cca3\",",
              "        \"independent\",",
              "        \"status\",",
              "        \"unMember\",",
              "        \"idd\",",
              "        \"capital\",",
              "        \"altSpellings\",",
              "        \"region\",",
              "        \"subregion\",",
              "        \"landlocked\",",
              "        \"area\",",
              "        \"maps\",",
              "        \"population\",",
              "        \"car\",",
              "        \"timezones\",",
              "        \"continents\",",
              "        \"flag\",",
              "        \"name\",",
              "        \"currencies\",",
              "        \"languages\",",
              "        \"latlng\",",
              "        \"demonyms\",",
              "        \"translations\",",
              "        \"flags\",",
              "        \"coatOfArms\",",
              "        \"startOfWeek\",",
              "        \"capitalInfo\",",
              "        \"postalCode\"",
              "    ];",
              "",
              "pm.test(\"Capital is Washington, D.C.\", () => {",
              "    pm.expect(countryData[0].capital[0]).to.eql(\"Washington, D.C.\");",
              "});",
              "",
              "pm.test(\"Flag is reflected correctly\", () => {",
              "    pm.expect(countryData[0].flag).to.eql(\"🇺🇸\");",
              "});",
              "",
              "pm.test(\"Population is greater than 340 million\", () => {",
              "    pm.expect(countryData[0].population).to.be.above(340000000);",
              "});",
              "",
              "pm.test(\"There are 317 suffixes\", () => {",
              "    pm.expect(countryData[0].idd.suffixes.length).to.eql(317);",
              "});",
              "",
              "pm.test(\"Timezones have correct values\", function () {",
              "    pm.expect(countryData[0].timezones).to.eql(expectedTimezones);",
              "});",
              "",
              "// Schema validation",
              "pm.test(\"Response structure should have all required keys \", () => {",
              "   countryData.forEach((item, index) => {",
              "        requiredKeys.forEach((key) => {",
              "            pm.expect(",
              "                item,",
              "                `Object at index ${index} is missing key: ${key}`",
              "            ).to.have.property(key);",
              "        });",
              "    });",
              "});",
              "",
              "",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{restCountriesBaseUrl}}/name/united%20states",
          "host": [
            "{{restCountriesBaseUrl}}"
          ],
          "path": [
            "name",
            "united%20states"
          ]
        }
      },
      "response": []
